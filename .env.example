# Required: Anthropic API key (used with anthropic/ models below)
PROVIDER_API_KEY=your_api_key_here

# Fast/cheap model for the Recruiter (Phase 0)
LLM_MODEL_FAST=anthropic/claude-haiku-4-5

# Standard model for expert agents (Phases 1-2) and Master Agent (Phase 3)
LLM_MODEL_STANDARD=anthropic/claude-haiku-4-5

# Optional: custom base URL for provider-compatible endpoints
# LLM_API_BASE=https://api.openai.com/v1

# Debate loop iterations (Phase 1). Must be 3 or 4.
MAX_DEBATE_TURNS=3
